{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "switchModelsOnFlag": false,
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(rtk git push --force*)",
      "Bash(rtk git push -f*)",
      "Bash(rtk git push * --force*)",
      "Bash(rtk git push * -f*)"
    ],
    "ask": ["Bash(git push *)", "Bash(rtk git push *)", "Bash(rm -rf *)"]
  },
  "statusLine": { "type": "command", "command": "\"__PYTHON__\" \"__CLAUDE_STATUSLINE__\"" }
}
