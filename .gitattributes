# Normalize line endings so the same repo works from WSL/Linux and native
# Windows clones without churn. Text is stored LF in the repo; shell scripts
# stay LF on checkout (must run under bash), PowerShell stays CRLF.

# Default: treat as text, store LF in the repo.
* text=auto eol=lf

# Repo helper scripts are bash (some are extensionless) — force LF.
scripts/**   text eol=lf
*.sh         text eol=lf
*.bash       text eol=lf
*.zsh        text eol=lf

# Configs consumed on the Linux/WSL side — force LF.
*.lua        text eol=lf
*.toml       text eol=lf
*.kdl        text eol=lf
*.conf       text eol=lf
*.json       text eol=lf
*.jsonc      text eol=lf

# PowerShell / Windows scripts — force CRLF.
*.ps1        text eol=crlf
*.psm1       text eol=crlf
*.psd1       text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf

# Binary assets — never modify.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.otf   binary
*.ttf   binary
