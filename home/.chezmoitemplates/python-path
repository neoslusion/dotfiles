{{- /*
  Absolute interpreter for the agent statuslines: agents run them through a
  non-interactive shell that may not have the interactive PATH. On Windows the
  WindowsApps `python` alias never counts: it is the Python install manager,
  adds ~100 ms per render and can print its own setup output into the bar.
  Forward slashes, so the path needs no escaping inside JSON.
*/ -}}
{{- $py := "" -}}
{{- if eq .chezmoi.os "windows" -}}
{{- /* Scoop's python first (Scoop owns the Windows tools), then a real one on
       PATH, then the usual install locations. */ -}}
{{- /* python3*: the pinned minor app from packages.yaml (python314, ...).
       Glob the app dirs, then stat current/: a wildcard glob does not descend
       through Scoop's `current` junction. */ -}}
{{-   $scoopPy := "" -}}
{{-   range glob (joinPath .chezmoi.homeDir "scoop/apps/python3*") -}}
{{-     $exe := joinPath . "current/python.exe" -}}
{{-     if stat $exe }}{{ $scoopPy = $exe }}{{ end -}}
{{-   end -}}
{{-   $onPath := lookPath "python" -}}
{{-   if $scoopPy -}}
{{-     $py = $scoopPy -}}
{{-   else if and $onPath (not (contains "WindowsApps" $onPath)) -}}
{{-     $py = $onPath -}}
{{-   else -}}
{{-     $local := env "LOCALAPPDATA" -}}
{{-     range (list (joinPath $local "Python/pythoncore-*/python.exe")
                    (joinPath $local "Programs/Python/Python3*/python.exe")) -}}
{{-       $hits := glob . -}}
{{-       if and (not $py) $hits }}{{ $py = last $hits }}{{ end -}}
{{-     end -}}
{{-   end -}}
{{-   $py = $py | default "python" -}}
{{- else -}}
{{- /* mise's python3 shim (mise installs python on every Unix setup): a fixed
       path, not lookPath, which finds /usr/bin/python3 before `mise install`
       and the shim after it, so the rendered settings would change between
       runs and `chezmoi verify` fails. */ -}}
{{-   $py = joinPath .chezmoi.homeDir ".local/share/mise/shims/python3" -}}
{{- end -}}
{{- $py | replace "\\" "/" -}}
