# Generated by `chezmoi init`; edit home/.chezmoi.toml.tmpl, then re-run init.
# The checkout itself is the source: `chezmoi init --source <checkout>`, so
# the repo you edit is what gets applied, with no second clone.
sourceDir = {{ .chezmoi.workingTree | quote }}

{{ if eq .chezmoi.os "windows" -}}
# .ps1 scripts run under pwsh 7, never Windows PowerShell 5.1.
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]
{{- end }}
